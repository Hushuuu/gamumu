{
  "name": "gamumu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "worker:dev": "wrangler dev --port 8787 --var ENABLE_DEV_ROLE_SELECTION:true",
    "dev:bots": "node scripts/dev-bots.mjs",
    "build:dev-bots:exe": "node scripts/build-dev-bots-exe.mjs",
    "worker:deploy": "wrangler deploy",
    "worker:types": "wrangler types",
    "worker:check": "wrangler types && tsc --project tsconfig.worker.json"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "tone": "^15.1.22",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "@yao-pkg/pkg": "^6.23.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.38.0"
  }
}
