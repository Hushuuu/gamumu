{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gamumu-api",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-29",
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameRoom"
      ]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,https://gamumu.nijidakku.cc"
  },
  "observability": {
    "enabled": true
  }
}